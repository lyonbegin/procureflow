# Reverse proxy to the native n8n editor (no extra browser Basic Auth prompt).
# n8n's own account/session authentication remains enabled.
# Block public first-owner registration until an owner is configured through
# an operator-controlled private setup path.
{
    auto_https off
    admin off
}
:8080 {
    @health path /healthz
    handle @health {
        respond "ok" 200
    }
    @owner_setup path /setup /setup/* /rest/owner/setup /rest/owner/setup/*
    handle @owner_setup {
        respond "Initial owner registration is not available on the public gateway." 403
    }
    handle {
        reverse_proxy http://n8n.railway.internal:5678 {
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-Host {host}
        }
        header Cache-Control "no-store"
        header X-Content-Type-Options "nosniff"
        header X-Frame-Options "DENY"
        header Referrer-Policy "same-origin"
    }
}
