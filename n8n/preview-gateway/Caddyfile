# Shared n8n editor gateway: NO additional HTTP Basic Auth.
# n8n maintains its own account/session authentication.
# Never expose an unclaimed n8n initial-owner registration endpoint publicly.
{
    auto_https off
    admin off
}
:8080 {
    @health path /healthz
    handle @health {
        respond "preview-gateway-up" 200
    }
    @owner_setup path /setup /setup/* /rest/owner/setup /rest/owner/setup/*
    handle @owner_setup {
        respond "n8n initial owner setup is restricted to a private operator session." 403
    }
    handle {
        reverse_proxy http://procureflow-shared-n8n-branch-pr.railway.internal:5678 {
            header_up X-Forwarded-Proto https
        }
        header Cache-Control "no-store"
        header X-Content-Type-Options "nosniff"
        header X-Frame-Options "DENY"
        header Referrer-Policy "same-origin"
    }
}
