# Public preview gateway; the n8n app itself has NO public Railway domain.
# Protect ALL editor, REST, and initial-owner setup paths with HTTP Basic Auth.
# Only intended for this isolated test service. Not the production n8n gateway.
{
    auto_https off
    admin off
}
:8080 {
    @health path /healthz
    handle @health {
        respond "preview-gateway-up" 200
    }
    handle {
        basic_auth {
            preview-operator {$PREVIEW_BASIC_HASH}
        }
        reverse_proxy http://procureflow-shared-n8n-branch-preview.railway.internal:5678 {
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-Host {host}
        }
        header Cache-Control "no-store"
        header X-Content-Type-Options "nosniff"
        header X-Frame-Options "DENY"
        header Referrer-Policy "same-origin"
    }
}
