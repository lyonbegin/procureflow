FROM python:3.12-slim-bookworm
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PORT=8000
WORKDIR /app
RUN pip install --no-cache-dir fastapi==0.115.12 "uvicorn[standard]==0.34.2" "psycopg[binary]==3.2.9" playwright==1.52.0 pypdf==5.7.0 olefile==0.47 \
 && python -m playwright install --with-deps chromium
COPY fresh_mobile_api.py fresh_mobile_tests.py fresh_g2b_store.py fresh_g2b_site.py fresh_g2b_api.py fresh_g2b.html fresh_g2b_tests.py g2b_bid_notice_site_search.py g2b_documents.py g2b_hwp5.py db.py /app/
RUN python -m py_compile fresh_mobile_api.py fresh_g2b_store.py fresh_g2b_site.py fresh_g2b_api.py g2b_bid_notice_site_search.py g2b_documents.py g2b_hwp5.py \
 && python -m unittest -v fresh_g2b_tests fresh_mobile_tests \
 && grep -q "section=public_nodes" fresh_g2b.html
EXPOSE 8000
CMD ["sh","-c","exec uvicorn fresh_g2b_api:app --host 0.0.0.0 --port $PORT"]
